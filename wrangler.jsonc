{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fblog-dns",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"vars": {
		"ROOT_DOMAIN": "fblog.cyou"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fblog-dns-db",
			"database_id": "cfb7e2e7-249a-4393-961a-6fca2de38a8d",
			"remote": true
		}
	]
}