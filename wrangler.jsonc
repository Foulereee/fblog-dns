{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fblog-dns",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	// 路由与自定义域名。
	// ⚠️ wrangler 4 已不支持顶层 `custom_domains` 字段（会被静默忽略并告警），
	//    自定义域名必须写成 routes 里 `custom_domain: true` 的形式。
	"routes": [
		// 平台自己的入口：管理面板 + API
		{
			"pattern": "dns.fblog.cyou",
			"custom_domain": true
		},
		// 通配路由：所有 *.fblog.cyou 的请求都交给本 Worker，由 Worker 按 Host 分发 ——
		// 若该子域名登记了反代目标，就转发到用户自己的 Workers/Pages；否则返回一张落地页。
		//
		// ⚠️ 前置条件：必须有一条「泛解析」DNS 记录，否则子域名解析不到 CF 边缘，
		//    通配路由永远不会触发（官方文档：Domains and subdomains must have a DNS
		//    Record to be proxied on Cloudflare and used to invoke a Worker）：
		//      AAAA  *.fblog.cyou   100::    代理状态：已代理（橙云）
		//    已有「仅 DNS（灰云）」记录的子域名优先级更高，照旧直连用户自己的服务器。
		//
		// ⚠️ 已知副作用（官方文档原文）："Routes can fetch() Custom Domains and take
		//    precedence if configured on the same hostname." —— 路由优先级高于自定义域名，
		//    所以本 zone 里「别的 Worker 的自定义域名」会被这条通配路由抢走（只有更精确的
		//    路由才能赢过它）。把这类主机名前缀登记到 vars.PLATFORM_HOSTS 即可避开。
		{
			"pattern": "*.fblog.cyou/*",
			"zone_name": "fblog.cyou"
		}
	],
	// Cloudflare Email Service：邮箱注册验证码 / 到期提醒
	// 需要在 Cloudflare 控制台把发件域名（如 mail.fblog.cyou）接入 Email Service 并验证
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	// 定时任务：每日 UTC 03:00 清理到期未续期的子域名
	"triggers": {
		"crons": ["0 3 * * *"]
	},
	"vars": {
		"ROOT_DOMAIN": "fblog.cyou",
		// 除 dns / www 之外，还要当成「平台自身入口」（走平台界面、不参与反代）处理的
		// 子域名前缀，逗号分隔。用途见上方通配路由的副作用说明：本 zone 内其它 Worker 的
		// 自定义域名会被通配路由抢走，把它的前缀登记到这里即可恢复。
		"PLATFORM_HOSTS": "",
		// 「透传」前缀，逗号分隔：命中的子域名不参与反代，而是把原始请求 fetch 出去，
		// 直达该主机名自定义域名背后的那个 Worker。
		//
		// 目前为空 —— cfnew3 的 cfnew.fblog.cyou 自定义域名已删除，不需要再透传；
		// 若继续留在名单里，透传出去会因没有自定义域名而回源到占位地址 100::，返回 522。
		// 以后再给本 zone 内其它 Worker 挂自定义域名时，记得把前缀加到这里。
		"PASSTHROUGH_HOSTS": "",
		// 反代分发时 name → 卡槽 的内存缓存 TTL（秒）。设 0 关闭缓存。
		// 缓存能省掉每个请求一次 D1 查询、并降低转发延迟；代价是用户改配置后
		// 最长这么多秒才生效。注意只缓存"查到了"的结果，新申请的子域名立即生效。
		"PROXY_CACHE_TTL": "30",
		// 单个主机名每分钟允许的请求数。仅在原生 RATE_LIMITER binding 不可用时
		// 作为兜底（内存计数，按 isolate，偏宽松）。原生 binding 的额度见下方 ratelimits。
		"RATE_LIMIT_PER_MIN": "1200",
		// 当日反代请求数超过该值时给管理员发一封告警邮件（每天最多一封）。
		// Workers 免费额度是 100,000/天，留 20% 余量。
		"USAGE_ALERT_THRESHOLD": "80000"
	},
	// 反代限流：保护平台自己的 Workers 免费额度不被单个站点刷爆。
	// ⚠️ 官方说明：额度是「单个 Cloudflare 机房内」的限额，不是全局限额 ——
	//    全球访问的站点实际允许量约为 limit × 命中机房数。它是滥用防护，不是精确计费控制。
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 1200,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fblog-dns-db",
			"database_id": "cfb7e2e7-249a-4393-961a-6fca2de38a8d",
			"remote": true
		}
	]
}